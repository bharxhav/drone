[toml-schema]
version = "1.0.0"

[elements.deployments]
type = "collection"
itemtype = "types.deployment"
minlength = 1
description = "Foundry deployments keyed by local aliases."

[types.deployment]
type = "table"

    [types.deployment.base_url]
    type = "string"
    pattern = "^https?://[^[:space:]]+/$"
    description = "Absolute Foundry base URL."

[types.deployment.token_env]
type = "string"
minlength = 1
description = "Environment variable containing the Foundry token."

[types.deployment.default]
type = "boolean"
optional = true
description = "Select this deployment when no declaration specifies one."
